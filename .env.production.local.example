# On the server: copy to .env.production.local and fill in. .env.production.local is gitignored.
# docker-compose.production.yml reads it (docs/deploy.md).

# The database's password. Letters and digits only, since it goes into a URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# The one login in front of the app and the API. Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the password'
# Keep the single quotes around the hash: it's full of $ signs.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''

# Optional. Without TYPESAFE_API_KEY nothing is classified; without DIGITRANSIT_API_KEY there are no Trips,
# no address search and no stops for transit alerts.
TYPESAFE_API_KEY=
DIGITRANSIT_API_KEY=

# Optional. Which build of api and web to run: latest by default, or a commit SHA to go back to that build.
PULSE_TAG=
