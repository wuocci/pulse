# Production config, committed. No secrets here: put them in .env.production.local on the server.
# Load order: .env.production, then .env.production.local (later wins). Real environment variables win over both.
NODE_ENV=production
PORT=3000
DIGITRANSIT_API_URL=https://api.digitransit.fi/routing/v2/hsl/gtfs/v1
# Pinned so a new Jev release can't change classifications silently.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
