# Development config, committed. No secrets here: put them in .env.local.
# Load order: .env.development, then .env.local (later wins). Real environment variables win over both.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
DIGITRANSIT_API_URL=https://api.digitransit.fi/routing/v2/hsl/gtfs/v1
TYPESAFE_DEFAULT_MODEL=jev-latest
# Days the ingest process keeps raw 5-minute Conditions
CONDITION_RETENTION_DAYS=90
