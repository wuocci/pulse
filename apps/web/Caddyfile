# Inside the web container: the built app, and /v0 passed on to the API, all behind one password until
# API keys exist (#3). HTTPS ends in front of this container (today `tailscale serve`), so this one speaks plain HTTP.
{
	auto_https off
	admin off
}

:80 {
	# Without both values Caddy refuses to start, so a missing password can't leave the app open.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	encode zstd gzip
	root * /srv

	handle /v0/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Vite names built files by their content, so a name never gets new content.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The page itself is checked again on every visit, so a new deploy shows up at once. Unknown paths get the
	# page too: the app reads the view from the URL.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
